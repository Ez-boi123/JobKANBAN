{
  "name": "jobkanban",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:all": "node scripts/launcher.mjs --dev",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "launch": "node scripts/launcher.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/api.test.mjs tests/design-tools.test.mjs tests/launcher.test.mjs tests/reminders.test.mjs tests/reminder-setup.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:reminders-browser": "node tests/reminders-browser.mjs",
    "test:setup-browser": "node tests/setup-browser.mjs",
    "test:controls": "node tests/controls.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.58.0",
    "prettier": "3.8.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
